{
  "name": "@meu-imovel-pe/web",
  "version": "0.1.0",
  "private": true,
  "description": "Web app - React + Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "test": "vitest",
